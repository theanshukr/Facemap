# Blockchain Network Configuration
# Supported options: polygon_amoy, sepolia, local
BLOCKCHAIN_NETWORK=polygon_amoy

# RPC Endpoints
POLYGON_AMOY_RPC_URL=https://polygon-amoy.drpc.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
LOCAL_RPC_URL=http://127.0.0.1:8545

# EVM Private Key for signing transactions (e.g. 0x...)
PRIVATE_KEY=your_private_key_here

# Deployed FaceProofRegistry Contract Address (e.g. 0x...)
REGISTRY_CONTRACT_ADDRESS=your_deployed_contract_address_here

# Reverse Image Search API Keys (Google Lens / SerpApi / Bing Visual Search)
SERPAPI_API_KEY=your_serpapi_key_here
BING_SEARCH_API_KEY=
SCRAPE_DO_TOKEN=

# Face Match Threshold for OpenCV SFace 128-D neural embeddings (Cosine similarity: default 0.70)
SIMILARITY_THRESHOLD=0.70
